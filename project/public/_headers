/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# HTML : pas de cache agressif (toujours la dernière version)
# (si tu as des routes HTML à la racine comme /, /produits.html, etc.)
/*.html
  Cache-Control: public, max-age=0, must-revalidate
# ---- EXCEPTIONS qui doivent se rafraîchir vite ----
/images/banner.svg
  Cache-Control: public, max-age=300
/images/banner-mobile.svg
  Cache-Control: public, max-age=300

/favicon.svg
  Cache-Control: public, max-age=3600
/favicon.ico
  Cache-Control: public, max-age=3600

/apple-touch-icon.png
  Cache-Control: public, max-age=86400

/sitemap.xml
  Cache-Control: public, max-age=300
/robots.txt
  Cache-Control: public, max-age=3600
# ---- RÈGLES GÉNÉRALES (cache long) ----
/images/*
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: image/svg+xml; charset=utf-8

/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable
